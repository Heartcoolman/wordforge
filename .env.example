# Runtime
HOST=127.0.0.1
PORT=3000
RUST_LOG=info
API_ONLY=false

# Self watchdog
ENABLE_SELF_WATCHDOG=false
SELF_WATCHDOG_INTERVAL_SECS=15
SELF_WATCHDOG_FAILURE_THRESHOLD=3

# Storage
DATABASE_URL=./data/learning.db
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CONNECTION_TIMEOUT_MS=250
# 峰值内存 ≈ 每连接 cache_size × pool 连接数；默认 8 兼顾并发吞吐与内存上界
SQLITE_POOL_SIZE=8

# Auth
# JWT 密钥 - 必须使用强随机值！生成命令: openssl rand -hex 32
# 警告: 不要使用默认值，不要在生产环境使用弱密钥
JWT_SECRET=MUST_CHANGE_USE_openssl_rand_hex_32
JWT_EXPIRES_IN_HOURS=24
REFRESH_TOKEN_EXPIRES_IN_HOURS=168
# Refresh Token 独立密钥（可选，默认从 JWT_SECRET 派生；生产环境请设置独立值）
REFRESH_JWT_SECRET=MUST_CHANGE_USE_openssl_rand_hex_32_refresh
# 管理员 JWT 密钥 - 必须与 JWT_SECRET 不同
ADMIN_JWT_SECRET=MUST_CHANGE_USE_openssl_rand_hex_32_different
ADMIN_JWT_EXPIRES_IN_HOURS=2
# 生产走 HTTPS(nginx TLS 终结)时必须改 true,否则 Cookie 可被明文窃取
COOKIE_SECURE=false

# Network
CORS_ORIGIN=http://localhost:5173
# 直连拓扑(无反代)保持 false;部署在 nginx 等反代之后必须改 true,
# 否则:① 资源包下载 URL 恒为 http://(HTTPS 站点触发 mixed-content)
# ② 限频/设备/审计取到的客户端 IP 全是反代 IP。
# 仅想修下载 URL 不动 IP 信任,可改用 RESOURCE_PACK_BASE_URL=https://<域名>
TRUST_PROXY=false
# TRUST_PROXY=true 时,X-Forwarded-Host 只有命中这份白名单(逗号分隔纯 hostname,不含端口/scheme,
# 大小写不敏感)才会被采信去拼资源包 manifest 的 downloadURL,否则回退真实 Host 头。
# 该响应带 60s 公共缓存,留空=不采信任何转发 host,防止伪造头污染下游共享/CDN 缓存。
RESOURCE_PACK_TRUSTED_HOSTS=

# Rate limit
RATE_LIMIT_WINDOW_SECS=900
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_SECS=60
AUTH_RATE_LIMIT_MAX=10
# W3-1: 遥测专项 per-user 限频（独立于通用 API 预算，超额软丢弃不落库）
RATE_LIMIT_TELEMETRY_WINDOW_SECS=60
RATE_LIMIT_TELEMETRY_MAX=120
# 遥测数据保留天数，超期由清理任务删除
TELEMETRY_RETENTION_DAYS=90

# Limits
# 单用户并发 SSE 连接上限，防单账号占满全局连接池
LIMITS_MAX_SSE_CONNECTIONS_PER_USER=5

# Worker
WORKER_LEADER=true
ENABLE_LLM_ADVISOR_WORKER=false
ENABLE_ENGINE_MONITORING_WORKER=true

# AMAS
AMAS_ENSEMBLE_ENABLED=true
AMAS_MONITOR_SAMPLE_RATE=0.05

# 文件日志开关
ENABLE_FILE_LOGS=false
# 日志目录
LOG_DIR=./logs

# Pagination
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100

# Strict mode
STRICT_MODE_ENABLED=false
STRICT_MODE_HARD_BLOCK=false
# 客户端最低版本限制（留空不限制）
# MIN_CLIENT_VERSION=1.0.0

# S2-1：records→AMAS outbox 异步消费路径（默认 false=同步老路；切 true 前须与学习端协同，amas_result 将异步返回）
# 注意：异步模式崩溃窗口下 AMAS 事件可能被重复应用（RFC R06，"重启不丢"≠"重启不重复"），启用前须评估
RECORDS_OUTBOX_ASYNC=false

# Remote probe（默认启用；设为 false 可关闭 kill switch）
PROBE_ENABLED=true
PROBE_RATE_LIMIT_PER_MIN=10
PROBE_MAX_TIMEOUT_MS=10000
PROBE_DEFAULT_TIMEOUT_MS=3000
PROBE_RETENTION_DAYS=60

# External Services (optional)
LLM_ENABLED=false
LLM_MOCK=true
LLM_API_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECS=30

# Update check + 一键自更新 (optional)
# 注意：必须使用 /releases?per_page=N list 端点（而非 /releases/latest），
# 以支持 stable / beta 双通道分流（/releases/latest 会跳过所有 prerelease）。
# per_page 需足够大，使「上一个 stable 版本」在持续发布 beta 期间仍落在窗口内被识别为 stable latest，
# 否则连续 beta 会把唯一的 stable release 挤出窗口，导致 stable 通道拿不到 latest。
UPDATE_CHECK_API_URL=https://api.github.com/repos/Heartcoolman/wordforge/releases?per_page=30
UPDATE_CHECK_CACHE_TTL_SECS=3600
# 后台 worker 定时检查新版本（缓存预热 + SSE 提醒）
ENABLE_UPDATE_CHECKER_WORKER=true
UPDATE_CHECKER_INTERVAL_SECS=3600
# 可选 GitHub PAT；不设走匿名 60/h 限额，设置后升到 5000/h
# WORDFORGE_GITHUB_TOKEN=ghp_xxx
# 允许"一键更新"安装比当前更旧的版本（默认 false，仅用于灰度回滚）
UPDATE_ALLOW_DOWNGRADE=false
# 安装目录；默认取 current_exe 的父目录
# UPDATE_INSTALL_DIR=/opt/wordforge
# 下载产物字节数上限（默认 200 MiB = 209715200）
UPDATE_MAX_TARBALL_BYTES=209715200
# 国内服务器到 GitHub release CDN 下载慢（实测阿里云 ECS 22 KB/s），
# 可填 GitHub 镜像加速前缀。规则：<prefix>/<原 GitHub URL>。
# 推荐: https://gh-proxy.com  | https://ghproxy.net  | https://mirror.ghproxy.com
# GITHUB_DOWNLOAD_MIRROR_PREFIX=https://gh-proxy.com
